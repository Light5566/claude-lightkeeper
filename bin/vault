#!/usr/bin/env python3
"""vault: the command-line door into the Lightkeeper plugin.

    vault find <terms> | --paths <files>   topic or file lookup, with blast radius
    vault check [--write]                  lint; --write rebuilds the index and reports
    vault sync [target] [--advance ...]    what landed on the repos since the vault caught up
    vault status                           coverage, stale, attention, drift on one screen
    vault log <note>                       that note's git history
    vault release vX.Y.Z [--since REF]     draft data for a release note
    vault export --html FILE               self-contained interactive map
    vault init <path> --repo <checkout>    scaffold and register a new vault
    vault init --install-cli               (re)install this launcher into ~/.local/bin

Finds the installed plugin through ~/.claude/plugins/installed_plugins.json so
the path survives plugin updates. CLAUDE_VAULT_PLUGIN overrides it (a dev
checkout). Every subcommand accepts --vault PATH; otherwise the vault covering
the current directory is used.
"""
import json
import os
import sys
from pathlib import Path

CMDS = {
    "find": "find.py", "check": "check.py", "sync": "sync.py", "status": "status.py",
    "log": "log.py", "release": "release.py", "export": "export_html.py",
    "canvas": "canvas.py", "init": "init.py",
}


def plugin_root():
    env = os.environ.get("CLAUDE_VAULT_PLUGIN")
    if env and (Path(env) / "lib" / "vaultlib.py").is_file():
        return Path(env)
    here = Path(__file__).resolve().parent.parent
    if (here / "lib" / "vaultlib.py").is_file():
        return here
    try:
        data = json.loads((Path.home() / ".claude" / "plugins" / "installed_plugins.json").read_text())
    except (OSError, ValueError):
        return None
    plugins = data.get("plugins", data) if isinstance(data, dict) else {}
    best = None
    for key, entries in plugins.items():
        if key.split("@")[0] != "vault":
            continue
        for e in entries if isinstance(entries, list) else [entries]:
            p = Path(str((e or {}).get("installPath", "")))
            if (p / "lib" / "vaultlib.py").is_file():
                stamp = str((e or {}).get("lastUpdated") or "")
                if best is None or stamp > best[0]:
                    best = (stamp, p)
    return best[1] if best else None


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    if cmd not in CMDS:
        sys.exit("vault: unknown command %r (try: vault --help)" % cmd)
    root = plugin_root()
    if not root:
        sys.exit("vault: the Lightkeeper plugin is not installed. In Claude Code: "
                 "/plugin marketplace add Light5566/claude-lightkeeper then /plugin install vault@claude-lightkeeper "
                 "— or set CLAUDE_VAULT_PLUGIN to a checkout.")
    script = root / "lib" / CMDS[cmd]
    if not script.is_file():
        sys.exit("vault: %r is not available in this version of the plugin (%s)" % (cmd, root))
    os.execv(sys.executable, [sys.executable, str(script)] + argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
